#!/bin/sh
# Runs after history is rewritten (e.g. `git pull --rebase`, `git rebase`,
# `git commit --amend`). Refreshes personal skills without fetching or updating
# third-party sources (post-merge does not fire on rebase pulls).

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! "$repo_dir/scripts/sync-agent-skills.sh" --offline; then
  printf 'Could not refresh personal Agent Skills; run scripts/sync-agent-skills.sh manually.\n' >&2
fi

exit 0
